<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 19 puts the grouping on `res.groups.privilege` rather than on
             the group itself; `res.groups.category_id` no longer exists. -->
        <record id="module_category_tour_booking" model="ir.module.category">
            <field name="name">Tour Booking</field>
            <field name="sequence">20</field>
        </record>

        <record id="res_groups_privilege_tour_booking" model="res.groups.privilege">
            <field name="name">Tour Booking</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="module_category_tour_booking"/>
        </record>

        <record id="group_tour_user" model="res.groups">
            <field name="name">Booking Desk</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_tour_booking"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Take and manage bookings on existing departures.</field>
        </record>

        <record id="group_tour_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_tour_booking"/>
            <field name="implied_ids" eval="[(4, ref('group_tour_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Design tours, set prices and define availability.</field>
        </record>

    </data>
</odoo>
