<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            A website visitor has to be able to *read* a tour, not because the
            templates need it — those run sudo() — but because the `/tour/<slug>`
            route resolves the record through Odoo's model converter, which does
            a real access check as the public user. Without this the page is a
            404 while the catalogue renders perfectly, which is a confusing thing
            to debug.

            Read access alone would expose unpublished drafts, so it is paired
            with the record rule below. The rule is the access control; the ACL
            only decides that reading is possible at all.
        -->
        <record id="tour_tour_rule_public" model="ir.rule">
            <field name="name">Only published tours are public</field>
            <field name="model_id" ref="model_tour_tour"/>
            <field name="domain_force">[('is_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            And its photographs, for a less obvious reason. The templates render
            the gallery through sudo(), so the markup is always right — but each
            `<img>` points at `/web/image/tour.tour.image/<id>/image_1920`, and
            that route does its own access check as the visitor. Without this
            every gallery photo is a broken-image placeholder on a page that
            otherwise looks perfect, which is why it went unnoticed: the tests
            asserted the tags were there, and they always were.
        -->
        <record id="tour_tour_image_rule_public" model="ir.rule">
            <field name="name">Only published tours' photos are public</field>
            <field name="model_id" ref="model_tour_tour_image"/>
            <field name="domain_force">[('tour_id.is_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            One instance, several operators. Every model below carries a
            company and none of them was constrained, so a desk user of one
            company could read — and on `tour.booking`, write — another's
            guests, prices, schedule and takings. On a single-company instance
            that is invisible, which is the state every instance is in right up
            until the day it is not.

            Scoped to internal users rather than global on purpose. Everything
            the public site reads it reads through `sudo()`, so a global rule
            would protect nothing there while adding a way for a visitor to be
            handed a 404 on a perfectly good page because the website's company
            and the tour's company disagree. The exposure being closed here is
            an internal one, and this is where it lives.

            The `company_id = False` branch is the standard idiom and is kept
            for the models that might one day allow it; today every one of them
            requires a company.
        -->
        <record id="tour_tour_company_rule" model="ir.rule">
            <field name="name">Experiences: own company only</field>
            <field name="model_id" ref="model_tour_tour"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="tour_departure_company_rule" model="ir.rule">
            <field name="name">Trips: own company only</field>
            <field name="model_id" ref="model_tour_departure"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="tour_booking_company_rule" model="ir.rule">
            <field name="name">Bookings: own company only</field>
            <field name="model_id" ref="model_tour_booking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="tour_extra_company_rule" model="ir.rule">
            <field name="name">Extras: own company only</field>
            <field name="model_id" ref="model_tour_extra"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
