<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Named after the job, not the table underneath it.

          Bookings     — the daily work: take one, find one, see the week,
                         print the list you take to the dock.
          Experiences  — what is on sale.
          Settings     — everything configured once and rarely touched.
    -->

    <menuitem id="menu_tour_booking_root" name="Tours"
              web_icon="tour_booking,static/description/icon.png"
              sequence="45"
              groups="tour_booking.group_tour_user"/>

    <!-- 1. Bookings -->

    <menuitem id="menu_tour_bookings" name="Bookings"
              parent="menu_tour_booking_root"
              sequence="10"/>

    <menuitem id="menu_tour_booking_new" name="Place a Booking"
              parent="menu_tour_bookings"
              action="tour_booking_new_action"
              sequence="10"/>

    <menuitem id="menu_tour_booking_all" name="All Bookings"
              parent="menu_tour_bookings"
              action="tour_booking_action"
              sequence="20"/>

    <menuitem id="menu_tour_calendar" name="Calendar"
              parent="menu_tour_bookings"
              action="action_booking_calendar"
              sequence="30"/>

    <menuitem id="menu_tour_passengers" name="Passenger List"
              parent="menu_tour_bookings"
              action="tour_passenger_action"
              sequence="40"/>

    <!-- 2. Experiences -->

    <menuitem id="menu_tour_experiences" name="Experiences"
              parent="menu_tour_booking_root"
              sequence="20"
              groups="tour_booking.group_tour_manager"/>

    <menuitem id="menu_tour_experience_new" name="New Experience"
              parent="menu_tour_experiences"
              action="tour_tour_new_action"
              sequence="10"/>

    <menuitem id="menu_tour_tours" name="All Experiences"
              parent="menu_tour_experiences"
              action="tour_tour_action"
              sequence="20"/>

    <menuitem id="menu_tour_availability" name="Availability Rules"
              parent="menu_tour_experiences"
              action="tour_availability_rule_action"
              sequence="30"/>

    <menuitem id="menu_tour_generate" name="Refresh Calendar"
              parent="menu_tour_experiences"
              action="action_generate_departures"
              sequence="40"/>

    <!-- 3. Settings -->

    <menuitem id="menu_tour_config" name="Settings"
              parent="menu_tour_booking_root"
              sequence="90"
              groups="tour_booking.group_tour_manager"/>

    <menuitem id="menu_tour_settings" name="General Settings"
              parent="menu_tour_config"
              action="base_setup.action_general_configuration"
              sequence="10"/>

    <menuitem id="menu_tour_policies" name="Cancellation Policies"
              parent="menu_tour_config"
              action="tour_cancellation_policy_action"
              sequence="20"/>

    <menuitem id="menu_tour_extras" name="Extras"
              parent="menu_tour_config"
              action="tour_extra_action"
              sequence="30"/>

    <menuitem id="menu_tour_questions" name="Checkout Questions"
              parent="menu_tour_config"
              action="tour_question_action"
              sequence="40"/>

    <menuitem id="menu_tour_locations" name="Meeting Points"
              parent="menu_tour_config"
              action="tour_location_action"
              sequence="50"/>

</odoo>
