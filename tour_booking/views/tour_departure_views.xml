<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tour_departure_view_list" model="ir.ui.view">
        <field name="name">tour.departure.list</field>
        <field name="model">tour.departure</field>
        <field name="arch" type="xml">
            <list string="Scheduled Trips" decoration-muted="state in ('cancelled', 'done')"
                  decoration-warning="state == 'full'">
                <field name="start_datetime"/>
                <field name="tour_id"/>
                <field name="capacity"/>
                <field name="seats_sold"/>
                <field name="seats_available"/>
                <field name="is_manually_adjusted" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'full'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="tour_departure_view_form" model="ir.ui.view">
        <field name="name">tour.departure.form</field>
        <field name="model">tour.departure</field>
        <field name="arch" type="xml">
            <form string="Scheduled Trip">
                <header>
                    <button name="action_cancel" type="object" string="Cancel Departure"
                            invisible="state in ('cancelled', 'done')"
                            confirm="Cancelling this departure stops it taking any further bookings. Guests already booked are not notified automatically."/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,full,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                            <field name="seats_sold" widget="statinfo" string="Seats Sold"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="When">
                            <field name="tour_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="start_datetime" readonly="1"/>
                            <field name="rule_id" readonly="1"/>
                        </group>
                        <group string="Seats">
                            <field name="capacity"/>
                            <field name="seats_sold"/>
                            <field name="seats_available"/>
                            <field name="min_pax"/>
                            <field name="max_pax"/>
                            <field name="is_manually_adjusted" readonly="1"
                                   help="Set as soon as anybody changes capacity or state by hand. The generator then leaves this departure alone for good."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bookings" name="bookings">
                            <field name="booking_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="pax"/>
                                    <field name="amount_total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tour_departure_view_calendar" model="ir.ui.view">
        <field name="name">tour.departure.calendar</field>
        <field name="model">tour.departure</field>
        <field name="arch" type="xml">
            <calendar string="Calendar" date_start="start_datetime" color="tour_id"
                      mode="month" quick_create="0" event_limit="5">
                <field name="tour_id" filters="1"/>
                <field name="seats_sold"/>
                <field name="seats_available"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="tour_departure_view_search" model="ir.ui.view">
        <field name="name">tour.departure.search</field>
        <field name="model">tour.departure</field>
        <field name="arch" type="xml">
            <search string="Scheduled Trips">
                <field name="tour_id"/>
                <field name="date"/>
                <filter name="upcoming" string="Upcoming"
                        domain="[('start_datetime', '&gt;=', datetime.datetime.now())]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="full" string="Full" domain="[('state', '=', 'full')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="has_seats" string="Seats Left" domain="[('seats_available', '&gt;', 0)]"/>
                <filter name="adjusted" string="Manually Adjusted"
                        domain="[('is_manually_adjusted', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_tour" string="Tour" context="{'group_by': 'tour_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tour_departure_action" model="ir.actions.act_window">
        <field name="name">Calendar</field>
        <field name="res_model">tour.departure</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing scheduled yet</p>
            <p>
                This is your schedule: one entry for each time a tour actually
                runs — the 09:00 boat on Friday the 14th, with its own seat
                count. Guests book a seat on one of these.
            </p>
            <p>
                They are created for you from a tour's availability rules. Open
                a tour, add a rule under Availability, then use
                Configuration &#8594; Refresh Calendar.
            </p>
        </field>
    </record>

    <record id="action_generate_departures" model="ir.actions.server">
        <field name="name">Refresh Calendar</field>
        <field name="model_id" ref="model_tour_departure"/>
        <field name="state">code</field>
        <field name="code">action = model.action_refresh_calendar()</field>
    </record>

</odoo>
