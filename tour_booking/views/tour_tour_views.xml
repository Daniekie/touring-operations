<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tour_tour_view_list" model="ir.ui.view">
        <field name="name">tour.tour.list</field>
        <field name="model">tour.tour</field>
        <field name="arch" type="xml">
            <list string="Tours">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="location_id" optional="show"/>
                <field name="duration_hours" widget="float_time"/>
                <field name="price_per_person" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="default_capacity"/>
                <field name="departure_count" string="Scheduled"/>
                <!-- The page each row already has. Shown rather than optional
                     and hidden: an operator browsing this list is the operator
                     who cannot find their tour pages. -->
                <field name="website_url" string="Page" widget="url" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- The default view for the Tours menu. A catalogue of photographs is a
         far better landing than a list of rows, and the images are already
         there for the website. -->
    <record id="tour_tour_view_kanban" model="ir.ui.view">
        <field name="name">tour.tour.kanban</field>
        <field name="model">tour.tour</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <!-- Every field reached through `record.` in the template has
                     to be declared here, or it is simply absent from the record
                     and the card throws on render. -->
                <field name="currency_id"/>
                <field name="location_id"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <!-- The image widget, not a hand-built <img>. Odoo 19
                             no longer exposes `kanban_image` to the template
                             context, and the widget serves the placeholder for
                             an empty field anyway. -->
                        <div class="o_tour_kanban_image">
                            <field name="image_1920" widget="image"
                                   options="{'size': [400, 260], 'img_class': 'w-100 h-100 object-fit-cover'}"/>
                        </div>
                        <div class="p-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="fs-5"><field name="name"/></strong>
                                <field name="is_published" widget="boolean_toggle"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-clock-o me-1" title="Duration"/>
                                <field name="duration_display"/>
                                <t t-if="record.location_id.value">
                                    <i class="fa fa-map-marker ms-2 me-1" title="Meeting point"/>
                                    <field name="location_id"/>
                                </t>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <field name="price_per_person" widget="monetary"/>
                                <span class="text-muted">
                                    <field name="departure_count"/> scheduled
                                </span>
                            </div>
                            <!-- The card is a picture of the page, so it may as
                                 well say where the page is. -->
                            <div class="text-muted small text-truncate mt-1">
                                <i class="fa fa-globe me-1" title="Website page"/>
                                <field name="website_url" widget="url"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--
        One page. An earlier version made the operator save a stub — name,
        duration, capacity, price — before it would show them anything else,
        which turned building one tour into two visits to the same form and left
        a half-made record behind if they walked away. Everything is here from
        the first keystroke.

        The tabs are split into two rows because eight in a line reads as a
        wall. The first row is what an experience needs before it can be sold;
        the second is detail that makes the page better and nothing depends on.
    -->
    <record id="tour_tour_view_form" model="ir.ui.view">
        <field name="name">tour.tour.form</field>
        <field name="model">tour.tour</field>
        <field name="arch" type="xml">
            <form string="Tour">
                <header>
                    <!-- The obvious way to finish. Odoo saves a record before it
                         runs an object button, which is the whole job — without
                         this the only button on a new form is the chatter's
                         "Send message", and the actual save is a small cloud
                         icon up in the breadcrumb. -->
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="id"/>
                    <button name="action_view_departures" type="object"
                            string="Calendar" class="oe_highlight" invisible="not id"/>
                    <button name="action_share" type="object"
                            string="Put on a website" invisible="not id"/>
                    <!-- Putting it on sale is the one thing on this form that
                         is a decision rather than a setting, so it gets Odoo's
                         own publish control rather than a checkbox in a list of
                         fields. Nothing to publish before the record exists. -->
                    <field name="is_published" widget="website_publish_button"
                           invisible="not id"/>
                </header>
                <sheet>
                    <!-- `id` has to be on the form for the expressions above and
                         on the stat buttons to read it. -->
                    <field name="id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <!-- The counts are the one thing that genuinely cannot exist
                         yet, and their buttons would open an action on a record
                         with no id. -->
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_view_departures" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="departure_count" widget="statinfo" string="Scheduled"/>
                        </button>
                        <button name="action_view_bookings" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Sunset Tour"/></h1>
                        <!-- Where this experience lives on the website.
                             Under the name rather than in a tab or behind the
                             Share button, because the question it answers —
                             "where is my page?" — is asked by somebody who does
                             not know the page exists, and so will not go
                             looking for it anywhere. There is nothing to create
                             in the website editor: saving this record is what
                             makes the page. -->
                        <div class="o_tour_page_url text-muted" invisible="not id">
                            <i class="fa fa-globe me-1" title="Website page"/>
                            <field name="website_full_url" widget="url" nolabel="1"
                                   readonly="1" class="oe_inline"/>
                            <span invisible="is_published" class="ms-1">
                                — not visible to visitors until you publish it.
                            </span>
                        </div>
                    </div>

                    <!-- The four things that have no sensible default and that
                         somebody has to decide before this can be sold. Meeting
                         point, start times and the cut-off all ship with an
                         answer that is right most of the time, so they live
                         under Optional with the rest of the settings. -->
                    <group>
                        <group string="The Basics">
                            <field name="duration_hours" widget="float_time"/>
                            <field name="default_capacity"/>
                        </group>
                        <group string="Pricing">
                            <field name="price_per_person"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <separator string="Required"/>
                    <notebook name="required">
                        <page string="Description" name="description">
                            <field name="description" placeholder="What the guest is buying..."/>
                        </page>
                        <page string="Start Times" name="start_times"
                              invisible="not has_specific_time">
                            <field name="start_time_ids">
                                <list editable="bottom">
                                    <field name="time_of_day" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Availability" name="availability">
                            <!-- `form_view_ref` points the Add dialog at a form
                                 with the Tour field hidden: on an unsaved tour
                                 there is no id to default it from, and a
                                 required field nobody can fill would block the
                                 dialog. The one2many sets it on save. -->
                            <field name="availability_rule_ids"
                                   context="{'default_tour_id': id,
                                             'form_view_ref': 'tour_booking.tour_availability_rule_view_form_embedded'}">
                                <list>
                                    <field name="internal_label"/>
                                    <field name="recurrence"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="min_pax"/>
                                    <field name="max_pax"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <separator string="Optional"/>
                    <notebook name="optional">
                        <!-- These used to be a group of their own above the
                             tabs, which put a heading called "Optional
                             Settings" on top of the section called "Required".
                             They are optional, so they live under Optional. -->
                        <page string="Settings" name="optional_settings">
                            <group>
                                <group string="Where and When">
                                    <field name="location_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="meeting_point_note"
                                           placeholder="Ask for Marco at the counter"/>
                                    <field name="has_specific_time"/>
                                    <field name="booking_cutoff_hours"/>
                                </group>
                                <group string="Terms">
                                    <field name="cancellation_policy_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Itinerary" name="itinerary">
                            <field name="itinerary_step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="duration_minutes"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="What's Included" name="inclusions">
                            <group>
                                <field name="inclusions" nolabel="1"
                                       placeholder="Included in the price..."/>
                                <field name="exclusions" nolabel="1"
                                       placeholder="Not included..."/>
                            </group>
                        </page>
                        <page string="Good to Know" name="know">
                            <group>
                                <field name="know_before_you_go" nolabel="1"/>
                                <field name="what_to_bring" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Extras &amp; Questions" name="extras">
                            <group>
                                <field name="extra_ids" widget="many2many_tags"/>
                                <field name="question_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Images" name="images">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_1920" widget="image" options="{'size': [80, 80]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tour_tour_view_search" model="ir.ui.view">
        <field name="name">tour.tour.search</field>
        <field name="model">tour.tour</field>
        <field name="arch" type="xml">
            <search string="Tours">
                <field name="name"/>
                <field name="location_id"/>
                <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="unpublished" string="Unpublished" domain="[('is_published', '=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_location" string="Meeting Point"
                            context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tour_tour_new_action" model="ir.actions.act_window">
        <field name="name">New Experience</field>
        <field name="res_model">tour.tour</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="tour_tour_action" model="ir.actions.act_window">
        <field name="name">Experiences</field>
        <field name="res_model">tour.tour</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first tour</p>
            <p>
                A tour is what you sell — the sunset cruise, the two-tank dive.
                It says what the experience is and what it costs, but not when
                it runs.
            </p>
            <p>
                When it runs comes from its availability rules, which fill in
                your Calendar. Guests then book a seat on one dated entry there.
            </p>
        </field>
    </record>

</odoo>
