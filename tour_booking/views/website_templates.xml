<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== The catalogue ==================== -->

    <template id="tours" name="Tours">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container my-5">
                    <h1 class="mb-4">Our Tours</h1>
                    <t t-call="tour_booking.experience_grid"/>
                </div>
            </div>
        </t>
    </template>

    <!-- ==================== One tour ==================== -->

    <template id="tour_detail" name="Tour">
        <t t-call="website.layout">
            <div id="wrap">
                <!-- The photos lead, full width, and everything else follows.
                     They used to be a background-image hero with a second wall
                     of thumbnails buried under the description — two bites at
                     the same job, neither of which could be enlarged. -->
                <div class="container mt-4">
                    <h1 t-field="tour.name" class="mb-3"/>
                    <t t-call="tour_booking.experience_gallery"/>
                    <!-- Duration, where from, what it costs — the three things
                         somebody scans for before reading a word. Under the
                         photos rather than above them: the mosaic is what the
                         page is selling, and a row of grey pills between the
                         title and the pictures pushed it down for no gain. The
                         price is still out here rather than at the top of the
                         booking card, which is sticky and slides under the
                         site header. -->
                    <div class="o_tour_meta mb-3">
                        <span><i class="fa fa-clock-o me-1"/><span t-field="tour.duration_display"/></span>
                        <span t-if="tour.location_id">
                            <i class="fa fa-map-marker me-1"/>
                            <span t-field="tour.location_id.name"/>
                        </span>
                        <span class="o_tour_meta_price">
                            <span t-field="tour.price_per_person"
                                  t-options="{'widget': 'monetary', 'display_currency': tour.currency_id}"/>
                            <span class="text-muted"> per person</span>
                        </span>
                    </div>
                </div>

                <div class="container my-5">
                    <div class="row">
                        <div class="col-lg-7">
                            <div t-field="tour.description" class="mb-4"/>

                            <section t-if="tour.itinerary_step_ids" class="o_tour_section">
                                <h3 class="o_tour_section_title">Itinerary</h3>
                                <ol class="o_tour_itinerary">
                                    <li t-foreach="tour.itinerary_step_ids" t-as="step">
                                        <strong t-field="step.name"/>
                                        <span t-if="step.duration_minutes" class="text-muted">
                                            (<t t-esc="step.duration_minutes"/> min)
                                        </span>
                                        <div t-field="step.description"/>
                                    </li>
                                </ol>
                            </section>

                            <section t-if="tour.inclusions or tour.exclusions" class="o_tour_section">
                                <h3 class="o_tour_section_title">What's included</h3>
                                <div class="row">
                                    <div t-if="tour.inclusions" class="col-md-6">
                                        <div t-field="tour.inclusions" class="o_tour_included"/>
                                    </div>
                                    <div t-if="tour.exclusions" class="col-md-6">
                                        <div t-field="tour.exclusions" class="o_tour_excluded"/>
                                    </div>
                                </div>
                            </section>

                            <section t-if="tour.know_before_you_go" class="o_tour_section">
                                <h3 class="o_tour_section_title">Know before you go</h3>
                                <div t-field="tour.know_before_you_go"/>
                            </section>

                            <section t-if="tour.what_to_bring" class="o_tour_section">
                                <h3 class="o_tour_section_title">What to bring</h3>
                                <div t-field="tour.what_to_bring"/>
                            </section>

                            <section t-if="tour.location_id" class="o_tour_section">
                                <h3 class="o_tour_section_title">Meeting point</h3>
                                <address>
                                    <strong t-field="tour.location_id.name"/><br/>
                                    <span t-field="tour.location_id.street"/><br/>
                                    <span t-field="tour.location_id.city"/>
                                </address>
                                <div t-field="tour.location_id.how_to_get_there"/>
                                <p t-if="tour.meeting_point_note" t-field="tour.meeting_point_note"/>
                            </section>

                            <section t-if="tour.cancellation_policy_id" class="o_tour_section">
                                <h3 class="o_tour_section_title">Cancellation policy</h3>
                                <div t-field="tour.cancellation_policy_id.description"/>
                                <ul class="list-unstyled">
                                    <li t-foreach="tour.cancellation_policy_id.rule_ids" t-as="rule">
                                        Cancel at least <t t-esc="rule.hours_before"/> hours before
                                        departure for a <t t-esc="int(rule.refund_percent)"/>% refund.
                                    </li>
                                </ul>
                            </section>
                        </div>

                        <!-- ===== The booking widget ===== -->
                        <div class="col-lg-5">
                            <div class="o_tour_sticky">
                                <t t-call="tour_booking.booking_widget"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ==================== Refusal ==================== -->

    <template id="booking_refused" name="Booking Refused">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container my-5">
                    <div class="alert alert-warning">
                        <h4>That departure could not be booked</h4>
                        <p t-if="reason" t-esc="reason"/>
                        <p t-else="">Somebody may have taken the last seats while you were deciding.</p>
                    </div>
                    <a t-att-href="tour.website_url" class="btn btn-primary">Back to the tour</a>
                </div>
            </div>
        </t>
    </template>

</odoo>
