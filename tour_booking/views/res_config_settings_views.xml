<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tour.booking</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tours" string="Tours" name="tour_booking"
                     groups="tour_booking.group_tour_manager">
                    <block title="Scheduling" name="tour_scheduling_container">
                        <setting id="tour_timezone" string="Tour Timezone"
                                 help="The timezone your start times are written in.">
                            <field name="tour_tz"/>
                            <div class="text-muted mt-2">
                                Departures are generated up to a year ahead, so
                                this is what keeps a 09:00 tour at 09:00 local
                                across a daylight saving change. It applies to
                                every tour: an operator runs in one place.
                            </div>
                        </setting>
                    </block>
                    <block title="Payments" name="tour_payment_container">
                        <setting id="tour_settlement_currency" string="Settlement Currency"
                                 help="The currency your payment provider charges in.">
                            <field name="tour_settlement_currency_id"/>
                            <div class="text-muted mt-2">
                                Leave empty when your provider charges in your
                                own currency: nothing is converted and there is
                                one number all the way through. Set it and every
                                booking fixes an exchange rate the moment it is
                                created — the guest is charged that rate, and a
                                refund repays what was taken, never a fresh
                                conversion.
                            </div>
                            <div class="mt-3">
                                <label for="tour_fx_margin" class="me-2"/>
                                <field name="tour_fx_margin" class="oe_inline"/>
                            </div>
                            <div class="text-muted mt-2">
                                Added to the day's rate, upward. Between fixing
                                the rate and the money landing, the rate moves;
                                this is who carries that.
                            </div>
                        </setting>
                    </block>
                    <block title="Widgets" name="tour_embed_container">
                        <setting id="tour_embed_domains" string="Allowed Embed Domains"
                                 help="Which websites may embed your booking widgets.">
                            <field name="tour_embed_domains"
                                   placeholder="https://example.com, https://www.example.com"/>
                            <div class="text-muted mt-2">
                                Leave empty and any site may embed them, which
                                is normally what you want — the widgets show a
                                public catalogue. Fill it in and browsers will
                                refuse to display your widgets anywhere else.
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
