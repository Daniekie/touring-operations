<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_generate_departures" model="ir.cron">
            <field name="name">Tour Booking: generate departures</field>
            <field name="model_id" ref="model_tour_departure"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_departures()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_release_abandoned_drafts" model="ir.cron">
            <field name="name">Tour Booking: release abandoned checkouts</field>
            <field name="model_id" ref="model_tour_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_release_abandoned_drafts()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
